{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "{{ name }}",
  "author": "ht",
  "themes": [
    {
      "name": "ht-{{ scheme-slug }}",
      "appearance": "{{ variant }}",
      "style": {
        "background.appearance": "opaque",
        "accents": [
          "{{ accent }}",
          "{{ blue }}",
          "{{ cyan }}",
          "{{ green }}",
          "{{ yellow }}",
          "{{ orange }}",
          "{{ red }}",
          "{{ magenta }}"
        ],
        "background": "{{ background }}",
        "border": "{{ selection }}",
        "border.variant": "{{ dark_background }}",
        "border.focused": "{{ accent }}",
        "border.selected": "{{ accent }}",
        "border.transparent": "#00000000",
        "border.disabled": "{{ muted }}",
        "elevated_surface.background": "{{ dark_background }}",
        "surface.background": "{{ dark_background }}",
        "element.background": "{{ dark_background }}",
        "element.hover": "{{ lighter_background }}",
        "element.active": "{{ selection }}",
        "element.selected": "{{ selection }}",
        "element.disabled": "{{ dark_background }}",
        "drop_target.background": "{{ selection }}66",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "{{ selection }}66",
        "ghost_element.active": "{{ selection }}99",
        "ghost_element.selected": "{{ selection }}66",
        "ghost_element.disabled": "{{ dark_background }}",
        "text": "{{ foreground }}",
        "text.muted": "{{ light_foreground }}",
        "text.placeholder": "{{ muted }}",
        "text.disabled": "{{ muted }}",
        "text.accent": "{{ accent }}",
        "icon": "{{ foreground }}",
        "icon.muted": "{{ light_foreground }}",
        "icon.disabled": "{{ muted }}",
        "icon.placeholder": "{{ muted }}",
        "icon.accent": "{{ accent }}",
        "status_bar.background": "{{ dark_background }}",
        "title_bar.background": "{{ dark_background }}",
        "title_bar.inactive_background": "{{ dark_background }}",
        "toolbar.background": "{{ background }}",
        "tab_bar.background": "{{ dark_background }}",
        "tab.inactive_background": "{{ dark_background }}",
        "tab.active_background": "{{ background }}",
        "search.match_background": "{{ accent }}55",
        "search.active_match_background": "{{ orange }}66",
        "panel.background": "{{ dark_background }}",
        "panel.focused_border": "{{ accent }}",
        "panel.indent_guide": "{{ selection }}",
        "panel.indent_guide_active": "{{ muted }}",
        "panel.indent_guide_hover": "{{ light_foreground }}",
        "panel.overlay_background": "{{ dark_background }}",
        "pane.focused_border": "{{ accent }}",
        "pane_group.border": "{{ selection }}",
        "scrollbar.thumb.background": "{{ muted }}",
        "scrollbar.thumb.hover_background": "{{ light_foreground }}",
        "scrollbar.thumb.active_background": "{{ foreground }}",
        "scrollbar.thumb.border": "{{ background }}",
        "scrollbar.track.background": "{{ dark_background }}",
        "scrollbar.track.border": "{{ background }}",
        "minimap.thumb.background": "{{ selection }}",
        "minimap.thumb.hover_background": "{{ lighter_background }}",
        "minimap.thumb.active_background": "{{ accent }}",
        "minimap.thumb.border": "{{ background }}",
        "editor.background": "{{ background }}",
        "editor.foreground": "{{ foreground }}",
        "editor.gutter.background": "{{ background }}",
        "editor.subheader.background": "{{ dark_background }}",
        "editor.active_line.background": "{{ selection }}55",
        "editor.highlighted_line.background": "{{ selection }}55",
        "editor.line_number": "{{ muted }}",
        "editor.active_line_number": "{{ accent }}",
        "editor.invisible": "{{ muted }}",
        "editor.wrap_guide": "{{ selection }}",
        "editor.active_wrap_guide": "{{ light_foreground }}",
        "editor.document_highlight.bracket_background": "{{ selection }}66",
        "editor.document_highlight.read_background": "{{ selection }}",
        "editor.document_highlight.write_background": "{{ accent }}33",
        "editor.indent_guide": "{{ selection }}",
        "editor.indent_guide_active": "{{ muted }}",
        "terminal.background": "{{ background }}",
        "terminal.ansi.background": "{{ background }}",
        "terminal.foreground": "{{ foreground }}",
        "terminal.bright_foreground": "{{ bright_foreground }}",
        "terminal.dim_foreground": "{{ light_foreground }}",
        "terminal.ansi.black": "{{ dark_background }}",
        "terminal.ansi.red": "{{ red }}",
        "terminal.ansi.green": "{{ green }}",
        "terminal.ansi.yellow": "{{ yellow }}",
        "terminal.ansi.blue": "{{ blue }}",
        "terminal.ansi.magenta": "{{ magenta }}",
        "terminal.ansi.cyan": "{{ cyan }}",
        "terminal.ansi.white": "{{ light_foreground }}",
        "terminal.ansi.bright_black": "{{ muted }}",
        "terminal.ansi.bright_red": "{{ bright_red }}",
        "terminal.ansi.bright_green": "{{ bright_green }}",
        "terminal.ansi.bright_yellow": "{{ bright_yellow }}",
        "terminal.ansi.bright_blue": "{{ bright_blue }}",
        "terminal.ansi.bright_magenta": "{{ bright_magenta }}",
        "terminal.ansi.bright_cyan": "{{ bright_cyan }}",
        "terminal.ansi.bright_white": "{{ bright_foreground }}",
        "terminal.ansi.dim_black": "{{ mix muted background 50% }}",
        "terminal.ansi.dim_red": "{{ mix red background 50% }}",
        "terminal.ansi.dim_green": "{{ mix green background 50% }}",
        "terminal.ansi.dim_yellow": "{{ mix yellow background 50% }}",
        "terminal.ansi.dim_blue": "{{ mix blue background 50% }}",
        "terminal.ansi.dim_magenta": "{{ mix magenta background 50% }}",
        "terminal.ansi.dim_cyan": "{{ mix cyan background 50% }}",
        "terminal.ansi.dim_white": "{{ mix light_foreground background 50% }}",
        "link_text.hover": "{{ accent }}",
        "conflict": "{{ orange }}",
        "conflict.border": "{{ orange }}",
        "conflict.background": "{{ orange }}22",
        "created": "{{ green }}",
        "created.border": "{{ green }}",
        "created.background": "{{ green }}22",
        "deleted": "{{ red }}",
        "deleted.border": "{{ red }}",
        "deleted.background": "{{ red }}22",
        "hidden": "{{ muted }}",
        "hidden.border": "{{ muted }}",
        "hidden.background": "{{ muted }}22",
        "hint": "{{ cyan }}",
        "hint.border": "{{ cyan }}",
        "hint.background": "{{ cyan }}22",
        "ignored": "{{ muted }}",
        "ignored.border": "{{ muted }}",
        "ignored.background": "{{ muted }}22",
        "modified": "{{ yellow }}",
        "modified.border": "{{ yellow }}",
        "modified.background": "{{ yellow }}22",
        "predictive": "{{ light_foreground }}",
        "predictive.border": "{{ light_foreground }}",
        "predictive.background": "{{ light_foreground }}22",
        "renamed": "{{ blue }}",
        "renamed.border": "{{ blue }}",
        "renamed.background": "{{ blue }}22",
        "info": "{{ blue }}",
        "info.border": "{{ blue }}",
        "info.background": "{{ blue }}22",
        "warning": "{{ yellow }}",
        "warning.border": "{{ yellow }}",
        "warning.background": "{{ yellow }}22",
        "error": "{{ red }}",
        "error.border": "{{ red }}",
        "error.background": "{{ red }}22",
        "success": "{{ green }}",
        "success.border": "{{ green }}",
        "success.background": "{{ green }}22",
        "unreachable": "{{ muted }}",
        "unreachable.border": "{{ muted }}",
        "unreachable.background": "{{ muted }}22",
        "version_control.added": "{{ green }}",
        "version_control.deleted": "{{ red }}",
        "version_control.modified": "{{ yellow }}",
        "version_control.renamed": "{{ blue }}",
        "version_control.conflict": "{{ orange }}",
        "version_control.conflict_marker.ours": "{{ green }}33",
        "version_control.conflict_marker.theirs": "{{ blue }}33",
        "version_control.ignored": "{{ muted }}",
        "debugger.accent": "{{ red }}",
        "editor.debugger_active_line.background": "{{ red }}12",
        "vim.mode.text": "{{ background }}",
        "vim.normal.foreground": "{{ background }}",
        "vim.helix_normal.foreground": "{{ background }}",
        "vim.visual.foreground": "{{ background }}",
        "vim.helix_select.foreground": "{{ background }}",
        "vim.insert.foreground": "{{ background }}",
        "vim.visual_line.foreground": "{{ background }}",
        "vim.visual_block.foreground": "{{ background }}",
        "vim.replace.foreground": "{{ background }}",
        "vim.normal.background": "{{ accent }}",
        "vim.helix_normal.background": "{{ accent }}",
        "vim.visual.background": "{{ blue }}",
        "vim.helix_select.background": "{{ blue }}",
        "vim.insert.background": "{{ green }}",
        "vim.visual_line.background": "{{ blue }}",
        "vim.visual_block.background": "{{ magenta }}",
        "vim.replace.background": "{{ red }}",
        "syntax": {
          "attribute": { "color": "{{ yellow }}" },
          "boolean": { "color": "{{ orange }}" },
          "comment": { "color": "{{ muted }}", "font_style": "italic" },
          "comment.doc": { "color": "{{ muted }}", "font_style": "italic" },
          "constant": { "color": "{{ orange }}" },
          "constructor": { "color": "{{ blue }}" },
          "embedded": { "color": "{{ foreground }}" },
          "emphasis": { "color": "{{ foreground }}", "font_style": "italic" },
          "emphasis.strong": { "color": "{{ foreground }}", "font_weight": 700 },
          "enum": { "color": "{{ cyan }}" },
          "function": { "color": "{{ blue }}" },
          "hint": { "color": "{{ cyan }}" },
          "keyword": { "color": "{{ magenta }}" },
          "label": { "color": "{{ blue }}" },
          "link_text": { "color": "{{ accent }}" },
          "link_uri": { "color": "{{ accent }}", "font_style": "underline" },
          "number": { "color": "{{ yellow }}" },
          "operator": { "color": "{{ red }}" },
          "predictive": { "color": "{{ muted }}", "font_style": "italic" },
          "preproc": { "color": "{{ cyan }}" },
          "primary": { "color": "{{ foreground }}" },
          "property": { "color": "{{ blue }}" },
          "punctuation": { "color": "{{ light_foreground }}" },
          "punctuation.bracket": { "color": "{{ light_foreground }}" },
          "punctuation.delimiter": { "color": "{{ light_foreground }}" },
          "punctuation.list_marker": { "color": "{{ magenta }}" },
          "punctuation.special": { "color": "{{ cyan }}" },
          "string": { "color": "{{ green }}" },
          "string.escape": { "color": "{{ orange }}" },
          "string.regex": { "color": "{{ orange }}" },
          "string.special": { "color": "{{ cyan }}" },
          "string.special.symbol": { "color": "{{ yellow }}" },
          "tag": { "color": "{{ red }}" },
          "text.literal": { "color": "{{ green }}" },
          "title": { "color": "{{ accent }}", "font_weight": 700 },
          "type": { "color": "{{ cyan }}" },
          "variable": { "color": "{{ foreground }}" },
          "variable.special": { "color": "{{ red }}" },
          "variant": { "color": "{{ orange }}" }
        }
      }
    }
  ]
}
